{
  "packages": ["rustup@latest", "protobuf@latest", "grpcurl@latest"],
  "shell": {
    "scripts": {
      "db": "docker compose up -d --wait",
      "start": "cargo run --locked",
      "check": "cargo fmt --all -- --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked",
      "integration": "cargo test --locked --test integration -- --ignored",
      "measure": "cargo run --locked --release --example measure",
      "build": "cargo build --locked --release",
      "client": "npm --prefix client run dev",
      "client-check": "npm --prefix client run check && npm --prefix client run build",
      "e2e": "npm --prefix client run e2e"
    }
  }
}
